            r ∈ executed.1.initial :: executed.1.grid ∧
              List.count CombinatorialContracts.QueryKind.response executed.2 = executed.1.responseQueries ∧
                List.count CombinatorialContracts.QueryKind.reward executed.2 = executed.1.rewardQueries ∧
