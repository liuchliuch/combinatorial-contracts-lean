CombinatorialContracts.Paper.theorem1.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) (hadd : CombinatorialContracts.HasAdditiveReward M) (supply : (ι → ℝ) → Finset ι)
  (hsupply : ∀ (p : ι → ℝ), (∀ (i : ι), 0 ≤ p i) → CombinatorialContracts.IsSupplyResponse M p (supply p)) {ε : ℝ}
  (hε : 0 < ε) (hε1 : ε < 1) (hn : 1 ≤ Fintype.card ι) :
  have executed :=
    CombinatorialContracts.SupplyProgram.eval supply M.reward M.cost (CombinatorialContracts.SupplyProgram.algorithm ε);
  have r := executed.1.output;
  r.share ∈ Set.Icc 0 1 ∧
    CombinatorialContracts.IsResponse M r.share r.response ∧
      r.reward = M.reward r.response ∧
        r.utility = CombinatorialContracts.principal M r.share ∧
          (1 - ε) * CombinatorialContracts.optimalValue M ≤ CombinatorialContracts.principal M r.share ∧
            r ∈ executed.1.initial :: executed.1.grid ∧
              List.count CombinatorialContracts.QueryKind.response executed.2 = executed.1.responseQueries ∧
                ↑(List.count CombinatorialContracts.QueryKind.response executed.2) ≤
                    20 * ↑(Fintype.card ι) * Real.log (↑(Fintype.card ι) + 1) / ε ∧
                  List.count CombinatorialContracts.QueryKind.reward executed.2 = Fintype.card ι ∧
                    List.count CombinatorialContracts.QueryKind.cost executed.2 = 1
