                        20 * ↑(Fintype.card ι) * Real.log (↑(Fintype.card ι) + 1) / ε ∧
                      List.count CombinatorialContracts.QueryKind.cost executed.2 = 1
CombinatorialContracts.Paper.theorem7_empty.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
