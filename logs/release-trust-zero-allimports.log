  (hτ : 0 ≤ τ) :
  have executed :=
    CombinatorialContracts.OracleProgram.evalIndexed oracle M.reward M.cost
      (CombinatorialContracts.OracleProgram.robustProgram ε τ) 0;
  executed.1.output.share = 1 ∧
    executed.1.output.response = ∅ ∧
      (1 - executed.1.output.share) * M.reward executed.1.output.response = 0 ∧
        CombinatorialContracts.optimalValue M = 0 ∧
          List.count CombinatorialContracts.QueryKind.response executed.2 = 1 ∧
            List.count CombinatorialContracts.QueryKind.reward executed.2 = 1 ∧
              List.count CombinatorialContracts.QueryKind.cost executed.2 = 1
CombinatorialContracts.SupplyProgram.{u_1, u_2} (ι : Type u_1) (α : Type u_2) : Type (max u_1 u_2)
CombinatorialContracts.SupplyProgram.algorithm_counts.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (supply : (ι → ℝ) → Finset ι) (value costValue : Finset ι → ℝ) (ε : ℝ) :
  have executed :=
    CombinatorialContracts.SupplyProgram.eval supply value costValue (CombinatorialContracts.SupplyProgram.algorithm ε);
  List.count CombinatorialContracts.QueryKind.response executed.2 = executed.1.responseQueries ∧
    List.count CombinatorialContracts.QueryKind.reward executed.2 = Fintype.card ι ∧
      List.count CombinatorialContracts.QueryKind.cost executed.2 = 1
CombinatorialContracts.Tightness.Bundle.normalized_localization_ratio {m : ℕ} {η : ℝ} (hm : 2 ≤ m) (hη : 0 < η)
  (hη1 : η < 1) (i : CombinatorialContracts.Tightness.Bundle.Action m)
  (hi : i ∈ CombinatorialContracts.Tightness.Bundle.A m) :
  CombinatorialContracts.welfare (CombinatorialContracts.Tightness.Bundle.normalizedModel m η hm hη hη1) /
      ((1 - (1 - (1 + η) / ↑m)) * (CombinatorialContracts.Tightness.Bundle.normalizedModel m η hm hη hη1).reward {i}) =
    ↑m * (1 + η + ↑m / 2) / (1 + η)
CombinatorialContracts.Tightness.proposition9_i (m : ℕ) (η : ℝ) (hm : 2 ≤ m) (hη : 0 < η) (hη1 : η < 1) :
  ∃ M,
    CombinatorialContracts.HasAdditiveReward M ∧
      M.reward Finset.univ = 1 ∧
        (∀ (T : Finset (CombinatorialContracts.Tightness.Bundle.Action m)), M.reward T ≤ 1) ∧
          ∃ α ∈ Set.Icc 0 1,
            ∃ S,
              CombinatorialContracts.IsResponse M α S ∧
                (1 - α) * M.reward S = CombinatorialContracts.optimalValue M ∧
                  (∀ β ∈ Set.Icc 0 1,
                      ∀ (T : Finset (CombinatorialContracts.Tightness.Bundle.Action m)),
                        CombinatorialContracts.IsResponse M β T →
                          (1 - β) * M.reward T = CombinatorialContracts.optimalValue M → β = α ∧ T = S) ∧
                    ∃ j ∈ S,
                      0 < M.reward {j} ∧
                        (∀ i ∈ S, M.reward {i} ≤ M.reward {j}) ∧
                          CombinatorialContracts.welfare M / ((1 - α) * M.reward {j}) =
                              ↑m * (1 + η + ↑m / 2) / (1 + η) ∧
                            ↑(2 * m) ^ 2 / 16 ≤ CombinatorialContracts.welfare M / ((1 - α) * M.reward {j})
CombinatorialContracts.Tightness.proposition9_ii (n : ℕ) (r : ℝ) (hn : 2 ≤ n) (hr : 1 < r) :
  ∃ M,
    CombinatorialContracts.HasAdditiveReward M ∧
      M.reward Finset.univ = 1 ∧
        (∀ (S : Finset (Fin n)), M.reward S ≤ 1) ∧
          Monotone M.cost ∧
            (∀ (S T : Finset (Fin n)),
                S ⊆ T → ∀ i ∉ T, M.cost (insert i S) - M.cost S ≤ M.cost (insert i T) - M.cost T) ∧
              CombinatorialContracts.welfare M / CombinatorialContracts.optimalValue M = ↑n - (↑n - 1) / r
CombinatorialContracts.approximate_clipped_welfare_estimate.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) {τ : ℝ} {T : Finset ι}
  (hT : CombinatorialContracts.IsApproxBestResponse M τ 1 T) :
  max 0 (M.reward T - M.cost T) ≤ CombinatorialContracts.welfare M ∧
    CombinatorialContracts.welfare M ≤ max 0 (M.reward T - M.cost T) + τ
CombinatorialContracts.approximate_oracle_robustness.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) {oracle : ℕ → ℝ → Finset ι} {ε τ : ℝ}
  (ho : CombinatorialContracts.IsApproxOracle M τ oracle) (hε : 0 < ε) (hε1 : ε < 1) (hτ : 0 ≤ τ) :
  (1 - ε) * CombinatorialContracts.optimalValue M - 3 * τ / ε ≤
    (CombinatorialContracts.robustAlgorithm oracle M.reward M.cost ε τ).output.utility
CombinatorialContracts.approximate_undershoot_payoff.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) {ε τ δ : ℝ} {T : Finset ι} (hε : 0 < ε) (hε1 : ε < 1) (hτ : 0 ≤ τ)
  (hP : 0 < CombinatorialContracts.optimalValue M) (hlo : (1 - ε / 3) ^ 2 * (1 - CombinatorialContracts.optimum M) ≤ δ)
  (hhi : δ ≤ (1 - ε / 3) * (1 - CombinatorialContracts.optimum M))
  (hT : CombinatorialContracts.IsApproxBestResponse M τ (1 - δ) T) :
  (1 - ε) * CombinatorialContracts.optimalValue M - 3 * τ / ε ≤ δ * M.reward T
CombinatorialContracts.empty_ground_zero.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) (hn : Fintype.card ι = 0) :
  CombinatorialContracts.welfare M = 0 ∧ CombinatorialContracts.optimalValue M = 0
CombinatorialContracts.eventually_exponential_supply_lower_bound_ennreal (Q V : ℕ → ENNReal) (δ C : ℝ) (d : ℕ)
  (hδ : 0 < δ)
  (hqueries :
    ∀ᶠ (n : ℕ) in Filter.atTop,
      ENNReal.ofReal (δ * 2 ^ (n - 1)) ≤ ENNReal.ofReal (8 * (↑n + 1) ^ 2) * Q n + 2 * V n + 1)
  (hpoly : ∀ᶠ (n : ℕ) in Filter.atTop, V n ≤ ENNReal.ofReal (C * (↑n + 1) ^ d)) :
  ∀ᶠ (n : ℕ) in Filter.atTop, ENNReal.ofReal ((3 / 2) ^ n) ≤ Q n
CombinatorialContracts.exists_optimum.{u} {ι : Type u} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) :
  ∃ α ∈ Set.Icc 0 1, ∀ β ∈ Set.Icc 0 1, CombinatorialContracts.principal M β ≤ CombinatorialContracts.principal M α
CombinatorialContracts.exists_response.{u} {ι : Type u} [Fintype ι] [DecidableEq ι] (M : CombinatorialContracts.Model ι)
  (α : ℝ) : ∃ S, CombinatorialContracts.IsResponse M α S
CombinatorialContracts.exists_reward_anchor.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) (S : Finset ι) (hS : 0 < M.reward S) :
  ∃ j ∈ S,
    0 < M.reward {j} ∧
      M.reward {j} ≤ M.reward S ∧ M.reward S ≤ ↑(Fintype.card ι) * M.reward {j} ∧ ∀ i ∈ S, M.reward {i} ≤ M.reward {j}
CombinatorialContracts.finite_first_appearance_bound.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι] (f : Finset ι → ℝ)
  (hzero : f ∅ = 0) (hnonneg : ∀ (S : Finset ι), 0 ≤ f S) (hmono : Monotone f)
  (hsub : ∀ (S T : Finset ι), f (S ∪ T) ≤ f S + f T) (k : ℕ) (a : ℕ → ℝ) (S : ℕ → Finset ι) (P : ℝ) (hP : 0 ≤ P)
  (hend : a k = 1) (hstep : ∀ t < k, a t ≤ a (t + 1)) (hupper : ∀ t < k, a t ≤ 1)
  (hprofit : ∀ t < k, (1 - a t) * f (S t) ≤ P) :
  ∑ t ∈ Finset.range k, (a (t + 1) - a t) * f (S t) ≤ ↑(Fintype.card ι) * P
CombinatorialContracts.geometric_cover_of_width {ε R b δ : ℝ} (hε : 0 < ε) (hε1 : ε < 1) (hR : 1 ≤ R) (hb : 0 ≤ b)
  (hlo : b / R ≤ δ) (hhi : δ ≤ b) :
  ∃ k < CombinatorialContracts.leastGridSteps (1 - ε) R + 1,
    (1 - ε) * δ ≤ b * (1 - ε) ^ (k + 1) ∧ b * (1 - ε) ^ (k + 1) ≤ δ
CombinatorialContracts.leastGridSteps_add_one_bound {ε R : ℝ} (hε : 0 < ε) (hε1 : ε < 1) (hR : 1 ≤ R) :
  ↑(CombinatorialContracts.leastGridSteps (1 - ε) R + 1) ≤ Real.log R / ε + 2
CombinatorialContracts.leastGridSteps_minimal {q R : ℝ} (he : ∃ k, q ^ k ≤ 1 / R) {j : ℕ}
  (hj : j < CombinatorialContracts.leastGridSteps q R) : 1 / R < q ^ j
CombinatorialContracts.leastGridSteps_one (q : ℝ) : CombinatorialContracts.leastGridSteps q 1 = 0
CombinatorialContracts.leastGridSteps_spec {ε R : ℝ} (hε : 0 < ε) (hε1 : ε < 1) (hR : 1 ≤ R) :
  (1 - ε) ^ CombinatorialContracts.leastGridSteps (1 - ε) R ≤ 1 / R
CombinatorialContracts.principal_le_welfare.{u} {ι : Type u} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) (α : ℝ) : CombinatorialContracts.principal M α ≤ CombinatorialContracts.welfare M
CombinatorialContracts.principal_nonneg.{u} {ι : Type u} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) {α : ℝ} (hα : α ≤ 1) : 0 ≤ CombinatorialContracts.principal M α
CombinatorialContracts.response_reward_mono.{u} {ι : Type u} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) : Monotone fun α => M.reward (CombinatorialContracts.response M α)
CombinatorialContracts.response_reward_monotone.{u} {ι : Type u} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) {α β : ℝ} {S T : Finset ι} (hαβ : α ≤ β)
  (hS : CombinatorialContracts.IsResponse M α S) (hT : CombinatorialContracts.IsResponse M β T) :
  M.reward S ≤ M.reward T
CombinatorialContracts.reward_anchored_scale_of_optimal_response.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) {α : ℝ} {S : Finset ι} (hα : α ∈ Set.Icc 0 1)
  (hS : CombinatorialContracts.IsResponse M α S)
  (hoptimal : (1 - α) * M.reward S = CombinatorialContracts.optimalValue M)
  (hopt : 0 < CombinatorialContracts.optimalValue M) {j : ι} (hj : j ∈ S)
  (hmax : ∀ i ∈ S, M.reward {i} ≤ M.reward {j}) :
  0 < M.reward {j} ∧
    0 < CombinatorialContracts.welfare M / (↑(Fintype.card ι) ^ 2 * M.reward {j}) ∧
      CombinatorialContracts.welfare M / (↑(Fintype.card ι) ^ 2 * M.reward {j}) ≤ 1 - α ∧
        1 - α ≤ min 1 (CombinatorialContracts.welfare M / M.reward {j}) ∧
          min 1 (CombinatorialContracts.welfare M / M.reward {j}) /
              (CombinatorialContracts.welfare M / (↑(Fintype.card ι) ^ 2 * M.reward {j})) ≤
            ↑(Fintype.card ι) ^ 2
CombinatorialContracts.robust_source_grid_cover {ρ R b δ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) (hR : 1 ≤ R) (hb : 0 ≤ b)
  (hδ : 0 ≤ δ) (hlo : b / R ≤ δ) (hhi : δ ≤ b) :
  ∃ k < CombinatorialContracts.leastGridSteps (1 - ρ) R + 2,
    (1 - ρ) ^ 2 * δ ≤ b * (1 - ρ) ^ k ∧ b * (1 - ρ) ^ k ≤ (1 - ρ) * δ
CombinatorialContracts.scaled_optimalValue.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) (scale : ℝ) (hscale : 0 < scale) :
  CombinatorialContracts.optimalValue (CombinatorialContracts.scaledModel M scale hscale) =
    scale * CombinatorialContracts.optimalValue M
CombinatorialContracts.scaled_response_iff.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) (scale : ℝ) (hscale : 0 < scale) (α : ℝ) (S : Finset ι) :
  CombinatorialContracts.IsResponse (CombinatorialContracts.scaledModel M scale hscale) α S ↔
    CombinatorialContracts.IsResponse M α S
CombinatorialContracts.scaled_welfare.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) (scale : ℝ) (hscale : 0 < scale) :
  CombinatorialContracts.welfare (CombinatorialContracts.scaledModel M scale hscale) =
    scale * CombinatorialContracts.welfare M
CombinatorialContracts.shifted_contract_valid {q b : ℝ} {k : ℕ} (hq : 0 < q) (hq1 : q < 1) (hb : 0 ≤ b) (hb1 : b ≤ 1) :
  0 < 1 - b * q ^ (k + 1) ∧ 1 - b * q ^ (k + 1) ≤ 1
CombinatorialContracts.subadditive_le_sum_singletons.{u_1} {ι : Type u_1} [DecidableEq ι] (f : Finset ι → ℝ)
  (hempty : f ∅ = 0) (hsub : ∀ (S T : Finset ι), f (S ∪ T) ≤ f S + f T) (S : Finset ι) : f S ≤ ∑ i ∈ S, f {i}
CombinatorialContracts.supplyResponse_iff_response.{u} {ι : Type u} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) (hadd : CombinatorialContracts.HasAdditiveReward M) {α : ℝ} {S : Finset ι}
  (hα : 0 < α) :
  CombinatorialContracts.IsSupplyResponse M (fun i => α * M.reward {i}) S ↔ CombinatorialContracts.IsResponse M α S
CombinatorialContracts.welfare_eq_zero_iff_optimalValue_eq_zero.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) :
  CombinatorialContracts.welfare M = 0 ↔ CombinatorialContracts.optimalValue M = 0
CombinatorialContracts.welfare_profit_comparison.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  (M : CombinatorialContracts.Model ι) :
  CombinatorialContracts.optimalValue M ≤ CombinatorialContracts.welfare M ∧
    CombinatorialContracts.welfare M ≤ ↑(Fintype.card ι) * CombinatorialContracts.optimalValue M
